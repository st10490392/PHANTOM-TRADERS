# Telegram alerting. Copy to .env alongside config/settings.py
# (loaded via python-dotenv). Real environment variables take precedence.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Historical replay. Directory of "<SYMBOL>_<TIMEFRAME>.csv" bars
# (columns: time,open,high,low,close[,volume]; time = epoch seconds UTC).
PHANTOM_DATA_DIR=./data
PHANTOM_RESULTS_DIR=./backtest_results

# Killzone clock: DST_LOCAL (zoneinfo seasonal shift) or UTC_FIXED (pinned UTC bounds)
PHANTOM_KILLZONE_MODE=DST_LOCAL

# Live MT5 feed + execution bridge.
# PHANTOM_MT5_FILES_DIR must point at the terminal's MQL5/Files folder, because the EA
# reads/writes through FILE_COMMON (phantom_bridge/orders + phantom_bridge/fills).
PHANTOM_MT5_FILES_DIR=./mt5_bridge
PHANTOM_MT5_SYMBOLS=VOL75=Volatility 75 Index,US30=US30
PHANTOM_MT5_MAGIC=20260115
PHANTOM_MT5_TIMEOUT_MS=5000

# Operator kill switch, checked every tick/scan (see core/resilience.py and deploy/README.md).
# Blocks new entries only; open positions keep being managed/closed. Unset/delete to resume.
# PHANTOM_HALT=1
# PHANTOM_HALT_FILE=./phantom.halt

