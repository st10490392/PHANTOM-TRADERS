# Telegram alerting. Copy to .env alongside config/settings.py
# (loaded via python-dotenv). Real environment variables take precedence.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Historical replay. Directory of "<SYMBOL>_<TIMEFRAME>.csv" bars
# (columns: time,open,high,low,close[,volume]; time = epoch seconds UTC).
PHANTOM_DATA_DIR=./data
PHANTOM_RESULTS_DIR=./backtest_results

